# Provider
PROVIDER_BASE_URL=http://localhost:3001
PROVIDER_API_KEY=test-dev-2026

# Optional inbound API key. Empty means authentication is disabled.
INBOUND_API_KEY=

# Local persistence. Production should point to a real Postgres-backed repository.
REPOSITORY_BACKEND=sqlite
SQLITE_PATH=data/notifications.db

# Timeouts and retries
AI_TIMEOUT_SECONDS=15
NOTIFY_TIMEOUT_SECONDS=6
AI_MAX_ATTEMPTS=3
NOTIFY_MAX_ATTEMPTS=5
AI_PARSE_ATTEMPTS=2

# Delivery rate limit
NOTIFY_RATE_PER_SECOND=4.0
NOTIFY_BURST=8

# Workers and queues
EXTRACTION_WORKERS=40
DELIVERY_WORKERS=10
EXTRACTION_QUEUE_SIZE=20000
DELIVERY_QUEUE_SIZE=20000
SHUTDOWN_TIMEOUT_SECONDS=10

# Input and logs
MAX_INPUT_CHARS=2000
MAX_REQUEST_BYTES=65536
LOG_LEVEL=INFO
